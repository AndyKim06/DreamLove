# DreamLove AI Chatbot Backend 환경 변수 설정


# Upstage Solar Pro 2 API 설정
SOLAR_API_KEY=your_solar_api_key_here
SOLAR_API_URL=https://api.upstage.ai/v1/solar/chat/completions

# 애플리케이션 설정
APP_NAME=DreamLove AI Chatbot
APP_VERSION=1.0.0
DEBUG=False

# CORS 설정 (쉼표로 구분된 origin 목록, * = 모든 origin 허용)
ALLOW_ORIGINS=["*"]